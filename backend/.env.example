# Crear estas bases vacías en PostgreSQL. No usar la base de otra aplicación.
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/stock_manager
TEST_DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/stock_manager_test
PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
# Elegir contraseñas locales de al menos 12 caracteres antes de ejecutar el seed.
# No completar ni subir este archivo de ejemplo con secretos reales.
# Cambiar a true solo después de verificar que DATABASE_URL apunta a desarrollo.
ALLOW_DEMO_SEED=false
SEED_OWNER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
